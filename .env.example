# Postgres on Neon (Singapore). Use the direct endpoint (no -pooler) for Prisma; quote the value.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/orbit?sslmode=require"
# Isolated test database (same Neon project, schema applied, starts empty). REQUIRED for every test run: the db,
# agent, knowledge and web vitest configs and `pnpm --filter @brandloop/web dev:e2e` replace DATABASE_URL with it,
# and refuse to run unless its database name ends in _test. Tests bulk-delete their own rows, so never point it at real data.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/orbit_test?sslmode=require"
NEONDB_URL=
# Clerk development instance (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# OpenAI via the Vercel AI SDK (Feature 1+)
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-6.1-sol for generation, gpt-6-luna for extraction)
# AI_MODEL_GENERATE=
# AI_MODEL_EXTRACT=
# AI_MODEL_EMBED=
# AI_MOCK_MODEL=1  # dev and e2e only; ignored in production
# Extra origins allowed for chat attachment URLs, comma-separated (same-origin /api/files/ is always allowed)
# BLOB_PUBLIC_ORIGIN=
# The app's public origin, used to trust /api/files/ attachment URLs (never taken from the request).
# Required in production for attachments; dev defaults to http://localhost:3000.
# APP_URL=http://localhost:3000
# Keep Clerk from auto-creating a temporary instance; use your own dev keys above.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Dedicated Clerk dev-instance test user for e2e (reset by apps/web/e2e/global.setup.ts; never a real account)
E2E_CLERK_USER_EMAIL=
# Video transcription (Feature 1). Keep disabled to avoid spending credits.
DEEPGRAM_API_KEY=
DEEPGRAM_ENABLED=false

# Marketing site origin, used for the Privacy and Terms links on the auth pages
NEXT_PUBLIC_MARKETING_URL=http://localhost:4321


# File storage (images, uploads, carousel PDFs). The Upstash bucket is PUBLIC: only public-safe files (generated images,
# logos, post media) go there, under unguessable profile-scoped keys. Private files (knowledge uploads, reference images)
# stay on local disk until a private bucket exists.
# STORAGE_DRIVER=local|upstash   # default: upstash in production when UPSTASH_BLOB_TOKEN is set, else local
# STORAGE_LOCAL_ROOT=.data/blob  # local disk root (public/ and private/ below it)
# UPSTASH_BLOB_PUBLIC_BASE=      # optional bucket URL prefix; stored objects keep the URL returned at upload
UPSTASH_BLOB_TOKEN=
# UPSTASH_BLOB_PRIVATE_TOKEN=    # pending a private bucket
# Upstash (scheduling via QStash, Redis over REST)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# LinkedIn (publishing stays off unless LINKEDIN_PUBLISH_ENABLED=1; tests always mock LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
LINKEDIN_PUBLISH_ENABLED=
# Email (notifications, approvals; e2e must never send real email)
RESEND_API_KEY=

# Visuals (AI images). The mock provider is the default outside production; tests and e2e always use it.
# VISUALS_ENABLED=1                       # default on in dev (mock); in production on only when a provider key exists
# VISUALS_PROVIDER=mock                   # mock | openai (openai uses OPENAI_API_KEY)
# VISUALS_OPENAI_MODEL=gpt-image-2.5-flare        # generation
# VISUALS_OPENAI_EDIT_MODEL=gpt-image-2.5-sunburst  # edits (better instruction following)
# VISUALS_QUALITY=medium                  # low | medium | high
# VISUALS_TEAM_DAILY_LIMIT=40
# VISUALS_GLOBAL_DAILY_LIMIT=500
# GOOGLE_GENERATIVE_AI_API_KEY=           # optional Gemini adapter (not built yet)

# Chat safety and cost caps (counters use UPSTASH_REDIS_REST_URL/TOKEN above; in memory when unset)
# CHAT_RATE_LIMIT_TURNS=20      # turns per profile per 10 minutes
# CHAT_DAILY_COST_USD=3         # estimated daily AI spend per profile before chat pauses until UTC midnight
# AI_PRICE_<MODEL_ID>="in,out"  # dollars per million tokens, to refine the cost estimate (e.g. AI_PRICE_GPT_6_1_SOL="2.5,10")
