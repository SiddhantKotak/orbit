# Local Postgres from docker-compose
DATABASE_URL=postgresql://brandloop:brandloop@localhost:5433/brandloop
# Clerk development instance (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Claude (Feature 1+)
ANTHROPIC_API_KEY=
# Keep Clerk from auto-creating a temporary instance; use your own dev keys above.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=1
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
E2E_CLERK_USER_EMAIL=
# Video transcription (Feature 1). Keep disabled to avoid spending credits.
DEEPGRAM_API_KEY=
DEEPGRAM_ENABLED=false
