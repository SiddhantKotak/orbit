generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

/// A signed-in person. Identity comes from Clerk.
model User {
  id               String       @id @default(cuid())
  clerkId          String       @unique
  email            String
  name             String?
  currentProfileId String?
  currentProfile   Profile?     @relation("CurrentProfile", fields: [currentProfileId], references: [id], onDelete: SetNull)
  memberships      Membership[]
  ownedProfiles    Profile[]    @relation("ProfileOwner")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/// Billing and collaboration unit. Owns the subscription (Feature 9) and its profiles.
model Team {
  id                  String          @id @default(cuid())
  name                String
  memberships         Membership[]
  profiles            Profile[]
  knowledgeItems      KnowledgeItem[]
  deletedAt           DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

/// A LinkedIn persona the user writes as. Language and timezone live here, not on User.
model Profile {
  id                  String          @id @default(cuid())
  team                Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId              String
  owner               User            @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId         String
  name                String
  fullName            String?
  jobTitle            String?
  company             String?
  bio                 String?
  avatarUrl           String?
  language            String          @default("en-US")
  timezone            String          @default("UTC")
  generationDayOfWeek Int             @default(1)
  onboardingCompleted Boolean         @default(false)
  memoryVersion       Int             @default(0)
  voiceStyleId        String?
  voiceStyle          VoiceStyle?     @relation("SelectedVoice", fields: [voiceStyleId], references: [id], onDelete: SetNull)
  memoryDocs          MemoryDoc[]
  strategy            Strategy?
  voiceStyles         VoiceStyle[]    @relation("ProfileVoices")
  knowledgeItems      KnowledgeItem[]
  knowledgeChunks     KnowledgeChunk[]
  backgroundJobs      BackgroundJob[]
  chats               Chat[]
  documents           Document[]
  currentFor          User[]          @relation("CurrentProfile")
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([teamId])
}

enum MemorySource {
  USER
  EXTRACTED
  IMPORTED
  MIRRORED
}

enum VoiceKind {
  PRESET
  OWN
  URL
}

enum KnowledgeType {
  TEXT
  DOCUMENT
  URL
  VIDEO
  IMAGE
}

enum KnowledgeStatus {
  PROCESSING
  READY
  FAILED
}

enum JobKind {
  MEMORY_IMPORT
  KNOWLEDGE_INGEST
  STRATEGY_GENERATE
  VOICE_EXTRACT
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A markdown memory document, keyed by path (e.g. "identity/about") within a profile.
model MemoryDoc {
  id        String       @id @default(cuid())
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  key       String
  content   String       @default("")
  source    MemorySource @default(USER)
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([profileId, key])
}

model Strategy {
  id              String    @id @default(cuid())
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String    @unique
  goal            String?
  goalWhy         String?
  positioning     String?
  positioningWhy  String?
  tagline         String?
  expertise       String?
  expertiseWhy    String?
  contentMix      Json?
  audienceBalance Json?
  contentFormats  Json?
  recurringSeries Json?
  generatedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Presets have a null profileId and a unique slug; own/url styles belong to a profile.
model VoiceStyle {
  id          String    @id @default(cuid())
  profile     Profile?  @relation("ProfileVoices", fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String?
  slug        String?   @unique
  kind        VoiceKind
  name        String
  tagline     String    @default("")
  guide       String    @default("")
  samplePosts String[]
  selectedBy  Profile[] @relation("SelectedVoice")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
}

model KnowledgeItem {
  id         String          @id @default(cuid())
  profile    Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  title      String
  type       KnowledgeType
  status     KnowledgeStatus @default(PROCESSING)
  content    String?
  summary    String?
  sourceUrl  String?
  fileKey    String?
  mimeType   String?
  sizeBytes  Int?
  error      String?
  shareScope String          @default("PROFILE")
  createdAt  DateTime        @default(now())

  @@index([profileId, createdAt])
}

enum ChunkSource {
  KNOWLEDGE
}

model KnowledgeChunk {
  id         String                 @id @default(cuid())
  profile    Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  sourceType ChunkSource
  sourceId   String
  ordinal    Int
  title      String
  text       String
  embedding  Unsupported("vector(1536)")?
  tsv        Unsupported("tsvector")?
  createdAt  DateTime               @default(now())

  @@unique([sourceType, sourceId, ordinal])
  @@index([profileId, sourceType])
  @@index([tsv], type: Gin, map: "KnowledgeChunk_tsv_gin")
  @@index([embedding], map: "KnowledgeChunk_embedding_hnsw")
}

model BackgroundJob {
  id        String    @id @default(cuid())
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  kind      JobKind
  status    JobStatus @default(QUEUED)
  input     Json
  output    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([profileId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

model Chat {
  id                     String    @id
  profile                Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String
  userId                 String
  title                  String    @default("New chat")
  pinned                 Boolean   @default(false)
  /// One post per chat, one chat per post.
  documentId             String?   @unique
  document               Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  activeRunId            String?
  activeRunStartedAt     DateTime?
  activeRequestMessageId String?
  stopRequestedRunId     String?
  lastActivityAt         DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  messages               Message[]

  @@index([profileId, deletedAt, lastActivityAt])
}

model Message {
  id        String   @id
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  seq       Int      @default(autoincrement())
  role      ChatRole
  parts     Json
  metadata  Json?
  context   Json?
  runId     String?
  createdAt DateTime @default(now())

  @@index([chatId, seq])
}

enum DocumentKind {
  TEXT
}

enum DocumentStatus {
  DRAFT
}

enum VersionSource {
  AI_CREATE
  AI_EDIT
  USER_EDIT
  RESTORE
  PROPOSAL
}

/// A post. The current text lives in the DocumentVersion whose number equals `version`.
model Document {
  id        String            @id @default(cuid())
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  kind      DocumentKind      @default(TEXT)
  status    DocumentStatus    @default(DRAFT)
  title     String
  version   Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  versions  DocumentVersion[]
  chat      Chat?

  @@index([profileId, deletedAt, updatedAt])
}

model DocumentVersion {
  id            String        @id @default(cuid())
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  version       Int
  text          String
  hook          String?
  source        VersionSource
  changeSummary String?
  createdAt     DateTime      @default(now())

  @@unique([documentId, version])
}
