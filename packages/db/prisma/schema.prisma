generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

/// A signed-in person. Identity comes from Clerk.
model User {
  id               String       @id @default(cuid())
  clerkId          String       @unique
  email            String
  name             String?
  currentProfileId String?
  currentProfile   Profile?     @relation("CurrentProfile", fields: [currentProfileId], references: [id], onDelete: SetNull)
  memberships      Membership[]
  ownedProfiles    Profile[]    @relation("ProfileOwner")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/// Billing and collaboration unit. Owns the subscription (Feature 9) and its profiles.
model Team {
  id                  String          @id @default(cuid())
  name                String
  memberships         Membership[]
  profiles            Profile[]
  knowledgeItems      KnowledgeItem[]
  storageObjects      StorageObject[]
  visuals             Visual[]
  creditAccount       CreditAccount?
  creditLedger        CreditLedger[]
  deletedAt           DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

/// A LinkedIn persona the user writes as. Language and timezone live here, not on User.
model Profile {
  id                  String           @id @default(cuid())
  team                Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId              String
  owner               User             @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId         String
  name                String
  fullName            String?
  jobTitle            String?
  company             String?
  bio                 String?
  avatarUrl           String?
  language            String           @default("en-US")
  timezone            String           @default("UTC")
  generationDayOfWeek Int              @default(1)
  onboardingCompleted Boolean          @default(false)
  memoryVersion       Int              @default(0)
  voiceStyleId        String?
  voiceStyle          VoiceStyle?      @relation("SelectedVoice", fields: [voiceStyleId], references: [id], onDelete: SetNull)
  memoryDocs          MemoryDoc[]
  strategy            Strategy?
  voiceStyles         VoiceStyle[]     @relation("ProfileVoices")
  knowledgeItems      KnowledgeItem[]
  knowledgeChunks     KnowledgeChunk[]
  backgroundJobs      BackgroundJob[]
  chats               Chat[]
  documents           Document[]
  carousels           Carousel[]
  storageObjects      StorageObject[]
  visuals             Visual[]
  brandTheme          BrandTheme?
  referenceImages     ReferenceImage[]
  currentFor          User[]           @relation("CurrentProfile")
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([teamId])
}

enum MemorySource {
  USER
  EXTRACTED
  IMPORTED
  MIRRORED
}

enum VoiceKind {
  PRESET
  OWN
  URL
}

enum KnowledgeType {
  TEXT
  DOCUMENT
  URL
  VIDEO
  IMAGE
}

enum KnowledgeStatus {
  PROCESSING
  READY
  FAILED
}

enum JobKind {
  MEMORY_IMPORT
  KNOWLEDGE_INGEST
  STRATEGY_GENERATE
  VOICE_EXTRACT
  STYLE_EXTRACT
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A markdown memory document, keyed by path (e.g. "identity/about") within a profile.
model MemoryDoc {
  id        String       @id @default(cuid())
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  key       String
  content   String       @default("")
  source    MemorySource @default(USER)
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([profileId, key])
}

model Strategy {
  id              String    @id @default(cuid())
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String    @unique
  goal            String?
  goalWhy         String?
  positioning     String?
  positioningWhy  String?
  tagline         String?
  expertise       String?
  expertiseWhy    String?
  contentMix      Json?
  audienceBalance Json?
  contentFormats  Json?
  recurringSeries Json?
  generatedAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Presets have a null profileId and a unique slug; own/url styles belong to a profile.
model VoiceStyle {
  id          String    @id @default(cuid())
  profile     Profile?  @relation("ProfileVoices", fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String?
  slug        String?   @unique
  kind        VoiceKind
  name        String
  tagline     String    @default("")
  guide       String    @default("")
  samplePosts String[]
  /// The compiled StyleProfile (packages/ai/src/style.ts), validated on write. Null for rows that only have a `guide`.
  styleProfile      Json?
  profileVersion    Int         @default(0)
  status            StyleStatus @default(READY)
  statusDetail      String?
  analyzedPostCount Int         @default(0)
  analyzedAt        DateTime?
  corpusHash        String?
  versions          VoiceStyleVersion[]
  corpus            StyleCorpusPost[]
  selectedBy  Profile[] @relation("SelectedVoice")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
}

enum StyleStatus {
  PENDING
  ANALYZING
  READY
  FAILED
}

enum CorpusSource {
  PASTE
  EXPORT
  ORBIT
}

/// An earlier compiled profile, kept so a re-extraction that made the style worse can be undone (last 10).
model VoiceStyleVersion {
  id           String     @id @default(cuid())
  voiceStyle   VoiceStyle @relation(fields: [voiceStyleId], references: [id], onDelete: Cascade)
  voiceStyleId String
  version      Int
  profile      Json
  corpusHash   String
  createdAt    DateTime   @default(now())

  @@unique([voiceStyleId, version])
}

/// One post of a style's corpus (a pasted post, a LinkedIn export row). Deduplicated by hash.
model StyleCorpusPost {
  id           String       @id @default(cuid())
  voiceStyle   VoiceStyle   @relation(fields: [voiceStyleId], references: [id], onDelete: Cascade)
  voiceStyleId String
  text         String
  source       CorpusSource
  postedAt     DateTime?
  hash         String
  createdAt    DateTime     @default(now())

  @@unique([voiceStyleId, hash])
}

model KnowledgeItem {
  id         String          @id @default(cuid())
  profile    Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  title      String
  type       KnowledgeType
  status     KnowledgeStatus @default(PROCESSING)
  content    String?
  summary    String?
  sourceUrl  String?
  fileKey    String?
  mimeType   String?
  sizeBytes  Int?
  error      String?
  shareScope String          @default("PROFILE")
  createdAt  DateTime        @default(now())

  @@index([profileId, createdAt])
}

enum ChunkSource {
  KNOWLEDGE
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  profile    Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  sourceType ChunkSource
  sourceId   String
  ordinal    Int
  title      String
  text       String
  embedding  Unsupported("vector(1536)")?
  tsv        Unsupported("tsvector")?
  createdAt  DateTime                     @default(now())

  @@unique([sourceType, sourceId, ordinal])
  @@index([profileId, sourceType])
  @@index([tsv], type: Gin, map: "KnowledgeChunk_tsv_gin")
  @@index([embedding], map: "KnowledgeChunk_embedding_hnsw")
}

model BackgroundJob {
  id        String    @id @default(cuid())
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  kind      JobKind
  status    JobStatus @default(QUEUED)
  input     Json
  output    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([profileId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

model Chat {
  id                     String    @id
  profile                Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String
  userId                 String
  title                  String    @default("New chat")
  pinned                 Boolean   @default(false)
  /// One post per chat, one chat per post.
  documentId             String?   @unique
  document               Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  activeRunId            String?
  activeRunStartedAt     DateTime?
  activeRequestMessageId String?
  stopRequestedRunId     String?
  lastActivityAt         DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  messages               Message[]

  @@index([profileId, deletedAt, lastActivityAt])
}

model Message {
  id        String   @id
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  seq       Int      @default(autoincrement())
  role      ChatRole
  parts     Json
  metadata  Json?
  context   Json?
  runId     String?
  createdAt DateTime @default(now())

  @@index([chatId, seq])
}

enum DocumentKind {
  TEXT
}

enum DocumentStatus {
  DRAFT
}

enum VersionSource {
  AI_CREATE
  AI_EDIT
  USER_EDIT
  RESTORE
  PROPOSAL
}

/// A post. The current text lives in the DocumentVersion whose number equals `version`.
model Document {
  id        String            @id @default(cuid())
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  kind      DocumentKind      @default(TEXT)
  status    DocumentStatus    @default(DRAFT)
  title     String
  /// The current version's number. A restore moves it backwards; the next edit writes max(version) + 1.
  version   Int               @default(1)
  /// Optimistic-concurrency token: bumped on every save and restore (the version number can't serve, it moves back).
  revision  Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  versions  DocumentVersion[]
  chat      Chat?
  visuals   Visual[]
  media     PostMedia[]
  carousels Carousel[]

  @@index([profileId, deletedAt, updatedAt])
}

model DocumentVersion {
  id            String        @id @default(cuid())
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  version       Int
  text          String
  hook          String?
  source        VersionSource
  changeSummary String?
  /// The edit proposal (its tool call id) a PROPOSAL version applied; one apply per proposal per document.
  proposalId    String?
  createdAt     DateTime      @default(now())

  @@unique([documentId, version])
  @@unique([documentId, proposalId])
}

enum StorageStore {
  PUBLIC
  PRIVATE
}

enum StorageKind {
  KNOWLEDGE
  VISUAL
  REFERENCE
  LOGO
  POST_MEDIA
  CAROUSEL_PDF
}

/// A file in blob storage. Every put records a row here in the same service call; deleting soft-deletes it, and a
/// daily job removes the blob once it has been deleted for a week. `url` is set for PUBLIC objects only.
model StorageObject {
  id           String           @id @default(cuid())
  profile      Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  key          String           @unique
  store        StorageStore
  kind         StorageKind
  contentType  String
  bytes        Int
  sha256       String
  width        Int?
  height       Int?
  url          String?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  versions     VisualVersion[]
  brandLogoFor BrandTheme[]
  referenceFor ReferenceImage[]
  postMedia    PostMedia[]

  @@index([profileId, kind, createdAt])
  @@index([deletedAt])
}

enum VisualStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VisualType {
  INFOGRAPHIC
  BEFORE_AFTER
  QUOTE
  GENERAL
}

enum VisualAspect {
  SQUARE
  PORTRAIT_4_5
  PORTRAIT_2_3
  LANDSCAPE_3_2
}

enum VisualVersionKind {
  GENERATED
  EDIT
  LOGO
  REVERT
}

/// An AI image made for a post (or from the library). Versions are immutable files; `currentVersion` points at one.
model Visual {
  id                 String          @id @default(cuid())
  profile            Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId          String
  team               Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId             String
  document           Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId         String?
  createdByUserId    String
  /// Client UUID: the idempotency key, unique per team.
  requestId          String
  status             VisualStatus    @default(PENDING)
  type               VisualType
  aspect             VisualAspect    @default(PORTRAIT_4_5)
  userPrompt         String
  /// What was sent to the provider; kept for debugging, never shown raw to other users.
  builtPrompt        String?
  customInstructions String?
  useBrandColours    Boolean         @default(true)
  referenceId        String?
  /// "openai:<model>" | "gemini:<model>" | "mock"
  provider           String?
  currentVersion     Int             @default(0)
  editCount          Int             @default(0)
  maxEdits           Int             @default(5)
  /// "generate" | "edit" | "logo" while a job runs: one operation at a time.
  activeOp           String?
  activeOpStartedAt  DateTime?
  /// Input of the operation in flight: `{instruction}` for an edit, `{x, y, sizePercent}` for a logo. Cleared when it ends.
  opInput            Json?
  /// User-safe.
  error              String?
  altText            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  versions           VisualVersion[]
  postMedia          PostMedia[]

  @@unique([teamId, requestId])
  @@index([profileId, deletedAt, createdAt])
  @@index([documentId])
}

model VisualVersion {
  id              String            @id @default(cuid())
  visual          Visual            @relation(fields: [visualId], references: [id], onDelete: Cascade)
  visualId        String
  version         Int
  kind            VisualVersionKind
  storageObject   StorageObject     @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)
  storageObjectId String
  editPrompt      String?
  width           Int
  height          Int
  createdAt       DateTime          @default(now())

  @@unique([visualId, version])
  @@index([storageObjectId])
}

/// One per team: the cached balance. The ledger is the audit trail.
model CreditAccount {
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String   @id
  balance           Int      @default(30)
  monthlyAllocation Int      @default(30)
  /// Refill (a reset, not cumulative) once now >= periodStartedAt + 30 days.
  periodStartedAt   DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum CreditReason {
  MONTHLY_RESET
  GENERATE
  REFUND
  ADJUSTMENT
  ADDON
}

model CreditLedger {
  id           String       @id @default(cuid())
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  profileId    String?
  delta        Int
  balanceAfter Int
  reason       CreditReason
  visualId     String?
  createdAt    DateTime     @default(now())

  /// One GENERATE and at most one REFUND per visual.
  @@unique([visualId, reason])
  @@index([teamId, createdAt])
}

enum BrandDecision {
  NONE
  CONFIRMED
  SKIPPED
}

/// A profile's brand colours (8 roles, #RRGGBB) and logo. No row means the Orbit default palette with decision NONE.
model BrandTheme {
  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String         @id
  background   String
  accent       String
  headline     String
  bodyText     String
  caption      String
  line         String
  bar          String
  highlightBar String
  logoObject   StorageObject? @relation(fields: [logoObjectId], references: [id], onDelete: SetNull)
  logoObjectId String?
  decision     BrandDecision  @default(NONE)
  /// "manual" | "image" | "default"
  source       String?
  updatedAt    DateTime       @updatedAt
}

/// An example image the user keeps to steer generation ("match this style"). Stored in the PRIVATE store only.
model ReferenceImage {
  id              String        @id @default(cuid())
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  title           String
  tags            String[]
  storageObject   StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)
  storageObjectId String
  width           Int
  height          Int
  createdAt       DateTime      @default(now())

  @@index([profileId, createdAt])
}

enum PostMediaKind {
  IMAGE
  DOCUMENT
}

/// A file attached to a post. For an attached visual, `storageObjectId` follows the visual's current version while the post
/// is a draft; once the post is published the publisher sets `frozenAt` and the row stays on the published file.
model PostMedia {
  id               String        @id @default(cuid())
  document         Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId       String
  kind             PostMediaKind
  position         Int
  visual           Visual?       @relation(fields: [visualId], references: [id], onDelete: SetNull)
  visualId         String?
  storageObject    StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)
  storageObjectId  String
  altText          String?
  /// LinkedIn's asset id for the uploaded file; cleared whenever the file changes.
  linkedinAssetUrn String?
  frozenAt         DateTime?
  createdAt        DateTime      @default(now())

  @@unique([documentId, visualId])
  @@index([documentId, position])
  @@index([visualId])
}

/// A saved carousel from the studio. `slides` is the studio's slide list; `revision` is the optimistic-concurrency token.
model Carousel {
  id            String    @id @default(cuid())
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  /// The post it was made from or attached to.
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId    String?
  title         String
  template      String
  aspect        String
  /// Everything else the studio holds besides slides: kit and logo.
  options       Json      @default("{}")
  slides        Json
  version       Int       @default(1)
  revision      Int       @default(1)
  /// The StorageObject id of the last exported PDF (public, unguessable key).
  pdfStorageKey String?
  pdfUrl        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([profileId, deletedAt, updatedAt])
  @@index([documentId])
}
