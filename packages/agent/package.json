{
  "name": "@brandloop/agent",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:chat": "tsx --env-file-if-exists=../../.env scripts/smoke-chat.ts",
    "smoke:draft": "tsx --env-file-if-exists=../../.env scripts/smoke-draft.ts",
    "smoke:edit": "tsx --env-file-if-exists=../../.env scripts/smoke-edit.ts",
    "eval": "tsx --env-file-if-exists=../../.env eval/run.ts",
    "smoke:style": "tsx --env-file-if-exists=../../.env scripts/smoke-style.ts"
  },
  "dependencies": {
    "@brandloop/ai": "workspace:*",
    "@brandloop/db": "workspace:*",
    "ai": "7.0.146",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.98",
    "@brandloop/config": "workspace:*",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
